<Project>

    <PropertyGroup>
        <AssemblyName>kgen.$(MSBuildProjectName)</AssemblyName>
        <Version>0.0.1</Version>
        <Company>KGen LLC</Company>
        <PackageProjectUrl>https://github.com/kgen-llc/framework.avalonia</PackageProjectUrl>
        <Authors>Frederic Forjan</Authors>
        <PackageId>$(AssemblyName)</PackageId>    
        <Product>KGen Framework</Product>
        <Copyright>Copyright 2025-2026 KGEN LLC</Copyright>    
    </PropertyGroup>

    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <AnalysisLevel>latest-all</AnalysisLevel>
    </PropertyGroup>


    <!-- Import analyzer configuration maintained separately -->
  <Import Project="Directory.Build.Analyzers.props" Condition="Exists('Directory.Build.Analyzers.props')" />
</Project>
