<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Title>KGen Framework Avalonia</Title>
    <Company>KGen LLC</Company>
    <Authors>Frederic Forjan</Authors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <Description>Base framework for some of our applications based on Avalonia</Description>
    <Product>Roslyn Viewer</Product>
    <Copyright>Copyright 2025 KGEN LLC</Copyright>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />



    <None Include="../README.md" Pack="true" PackagePath="\" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Framework/Framework.csproj" />
  </ItemGroup>
</Project>
